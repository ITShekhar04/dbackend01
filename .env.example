# ==============================================================================
# Multi-Platform Data Integration & Intelligence System Configuration
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# Periodic Data Refresh Interval (Minutes: 15, 30, or 60)
REFRESH_INTERVAL_MINUTES=15

# Database Configuration (SQLite default; PostgreSQL connection string for production)
DATABASE_URL=sqlite:///./data/multi_platform.db

# ------------------------------------------------------------------------------
# Official Platform API Credentials
# NOTE: Connectors operate in safely labeled "DEMO DATA" mode if credentials are unset.
# When valid credentials are supplied, official API calls are automatically activated.
# ------------------------------------------------------------------------------

# 1. YouTube Data API v3
# Developer Portal: https://console.cloud.google.com/
# Setup: Enable "YouTube Data API v3" -> Credentials -> Create API Key
# Limitation: 10,000 units/day quota. Search calls consume 100 units each.
YOUTUBE_API_KEY=

# 2. Instagram (Meta Graph API)
# Developer Portal: https://developers.facebook.com/
# Setup: Create App -> Instagram Graph API -> Link Instagram Professional Account
# Required Permissions: instagram_basic, instagram_manage_insights, pages_show_list
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# 3. Facebook Graph API
# Developer Portal: https://developers.facebook.com/
# Setup: Create App -> Generate Page Access Token with pages_read_engagement
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# 4. X / Twitter API v2
# Developer Portal: https://developer.x.com/
# Setup: Developer Portal -> Create Project & App -> Generate OAuth 2.0 / Bearer Token
# Limitation: Basic Tier search is restricted to recent 7 days of public tweets.
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 5. Reddit API (OAuth2)
# Developer Portal: https://www.reddit.com/prefs/apps
# Setup: "are you a developer? create an app..." -> Select "script"
# Rate limit: 60 requests per minute with OAuth2 or 10 req/min unauthenticated.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DhristiIntelligence/1.0 (by /u/dhristi_team)

# 6. News API / GNews API
# Developer Portal: https://newsapi.org/ or https://gnews.io/
# Setup: Register account -> copy free developer tier API Key
# Limitation: NewsAPI developer plan free tier is for development / localhost only.
NEWS_API_KEY=
GNEWS_API_KEY=
